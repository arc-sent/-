# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Базовый URL API
API_URL=https://api.prmotion.me/v1

# Telegram ID администраторов через запятую (опционально).
# Если задано — регистрироваться и пользоваться ботом смогут только эти ID.
# Оставь пустым, чтобы разрешить регистрацию всем.
ADMIN_IDS=

# Валюта по умолчанию для баланса/заказов (RUB или USD)
DEFAULT_CURRENCY=RUB

# Путь к файлу БД SQLite (по умолчанию bot.db рядом с ботом)
DB_PATH=bot.db
